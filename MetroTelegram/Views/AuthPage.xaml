<phone:PhoneApplicationPage
    x:Class="MetroTelegram.Views.AuthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    Background="{StaticResource OledPureBlackBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.Opacity="0.0">

    <Grid x:Name="LayoutRoot" Background="Transparent" Margin="24,32,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Text="TELEGRAM" 
                       FontFamily="Segoe UI Semibold" 
                       FontSize="13" 
                       Foreground="{StaticResource PhoneSubtleForegroundBrush}"/>
            <TextBlock x:Name="TitleTextBlock" 
                       Text="ваш номер" 
                       FontFamily="Segoe UI Light" 
                       FontSize="54" 
                       Margin="0,-8,0,0"/>
        </StackPanel>

        <Grid x:Name="PhoneStepGrid" Grid.Row="1" Visibility="Visible">
            <StackPanel>
                <TextBlock Text="Введите номер телефона в международном формате:" 
                           Style="{StaticResource ChatPreviewTextStyle}" 
                           Margin="0,0,0,24"/>

                <TextBox x:Name="PhoneTextBox" 
                         Text="+7" 
                         FontFamily="Segoe UI" 
                         FontSize="26" 
                         InputScope="TelephoneNumber"
                         Margin="-12,0,-12,16"/>

                <Button x:Name="SendCodeButton" 
                        Content="получить код" 
                        Click="SendCodeButton_Click"
                        FontFamily="Segoe UI Semibold" 
                        FontSize="20"
                        Margin="-12,12,-12,0"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="CodeStepGrid" Grid.Row="1" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="CodePromptTextBlock" 
                           Text="Код подтверждения отправлен в чат Telegram:" 
                           Style="{StaticResource ChatPreviewTextStyle}" 
                           Margin="0,0,0,24"/>

                <TextBox x:Name="CodeTextBox" 
                         FontFamily="Segoe UI Light" 
                         FontSize="36" 
                         TextAlignment="Center"
                         InputScope="Number"
                         MaxLength="6"
                         Margin="-12,0,-12,16"/>

                <Button x:Name="SignInButton" 
                        Content="войти" 
                        Click="SignInButton_Click"
                        FontFamily="Segoe UI Semibold" 
                        FontSize="20"
                        Margin="-12,12,-12,0"/>

                <Button x:Name="ChangePhoneButton" 
                        Content="изменить номер" 
                        Click="ChangePhoneButton_Click"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="{StaticResource PhoneSubtleForegroundBrush}"
                        FontSize="16"
                        Margin="-12,8,-12,0"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="PasswordStepGrid" Grid.Row="1" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="У вас включена двухфакторная аутентификация. Введите облачный пароль:" 
                   Style="{StaticResource ChatPreviewTextStyle}" 
                   Margin="0,0,0,16"/>

                <TextBlock x:Name="PasswordHintTextBlock" 
                   Text="" 
                   FontSize="14"
                   Foreground="{StaticResource PhoneAccentBrush}"
                   Margin="0,0,0,16"/>

                <PasswordBox x:Name="CloudPasswordBox" 
                     FontSize="24"
                     Margin="-12,0,-12,16"/>

                <Button x:Name="SubmitPasswordButton" 
                Content="подтвердить пароль" 
                Click="SubmitPasswordButton_Click"
                FontFamily="Segoe UI Semibold" 
                FontSize="20"
                Margin="-12,12,-12,0"/>

                <Button x:Name="Cancel2FaButton" 
                Content="назад к вводу номера" 
                Click="ChangePhoneButton_Click"
                Background="Transparent"
                BorderBrush="Transparent"
                Foreground="{StaticResource PhoneSubtleForegroundBrush}"
                FontSize="16"
                Margin="-12,8,-12,0"/>
            </StackPanel>
        </Grid>
    </Grid>

</phone:PhoneApplicationPage>