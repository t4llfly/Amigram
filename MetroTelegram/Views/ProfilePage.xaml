<phone:PhoneApplicationPage
    x:Class="MetroTelegram.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    Background="{StaticResource OledPureBlackBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.Opacity="0.0">

    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <phone:Pivot Title="AMIGRAM" TitleTemplate="{StaticResource MetroPivotTitleTemplate}">

            <phone:PivotItem Header="инфо">
                <ScrollViewer Margin="0,0,-12,0">
                    <StackPanel Margin="0,0,12,32">

                        <Grid Margin="0,4,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="72" Height="72" 
                                    Background="{StaticResource PhoneAccentBrush}" 
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AvatarInitials}" 
                                           Foreground="White" 
                                           FontFamily="Segoe UI Semibold" 
                                           FontSize="28"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" 
                                           FontFamily="Segoe UI Light" 
                                           FontSize="26"
                                           Foreground="{StaticResource PhoneForegroundBrush}"
                                           TextTrimming="WordEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" 
                                           FontFamily="Segoe UI" 
                                           FontSize="14" 
                                           Foreground="{StaticResource PhoneSubtleForegroundBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource SubtleGrayBrush}" Padding="16,12,16,12" Margin="0,0,0,8" Visibility="{Binding PhoneVisibility}">
                            <StackPanel>
                                <TextBlock Text="Телефон" FontSize="13" Foreground="{StaticResource PhoneSubtleForegroundBrush}"/>
                                <TextBlock Text="{Binding Phone}" FontSize="18" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SubtleGrayBrush}" Padding="16,12,16,12" Margin="0,0,0,8" Visibility="{Binding UsernameVisibility}">
                            <StackPanel>
                                <TextBlock Text="Имя пользователя" FontSize="13" Foreground="{StaticResource PhoneSubtleForegroundBrush}"/>
                                <TextBlock Text="{Binding Username}" FontSize="18" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SubtleGrayBrush}" Padding="16,12,16,12" Margin="0,0,0,24" Visibility="{Binding AboutVisibility}">
                            <StackPanel>
                                <TextBlock Text="О себе / Описание" FontSize="13" Foreground="{StaticResource PhoneSubtleForegroundBrush}"/>
                                <TextBlock Text="{Binding About}" FontSize="16" FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SubtleGrayBrush}" Padding="16,12,16,12" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Идентификатор Telegram ID" FontSize="13" Foreground="{StaticResource PhoneSubtleForegroundBrush}"/>
                                <TextBlock Text="{Binding Id}" FontSize="16" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </phone:PivotItem>

            <phone:PivotItem Header="участники" Visibility="{Binding MembersTabVisibility}">
                <phone:LongListSelector 
                    x:Name="MembersList"
                    ItemsSource="{Binding Members}"
                    SelectionChanged="MembersList_SelectionChanged"
                    Margin="0,0,-12,0">
                    <phone:LongListSelector.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,12,18" Background="Transparent" toolkit:TiltEffect.IsTiltEnabled="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="44" Height="44" 
                                        Background="{StaticResource SubtleGrayBrush}" 
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initials}" 
                                               Foreground="{StaticResource PhoneForegroundBrush}" 
                                               FontFamily="Segoe UI" 
                                               FontSize="16"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FullName}" 
                                               Style="{StaticResource ChatTitleTextStyle}" 
                                               FontSize="19"/>
                                    <TextBlock Text="{Binding Status}" 
                                               FontSize="13" 
                                               Foreground="{StaticResource PhoneSubtleForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </phone:LongListSelector.ItemTemplate>
                </phone:LongListSelector>
            </phone:PivotItem>

        </phone:Pivot>
    </Grid>

</phone:PhoneApplicationPage>