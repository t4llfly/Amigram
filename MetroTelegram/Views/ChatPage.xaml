<phone:PhoneApplicationPage
    x:Class="MetroTelegram.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    Background="{StaticResource OledPureBlackBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.Opacity="0.0">

    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>
    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0C0C0C" Padding="20,18,20,12" Margin="0,0,0,4">
            <StackPanel>
                <TextBlock x:Name="ChatTitleTextBlock" 
                           Text="Диалог" 
                           FontFamily="Segoe UI Light" 
                           FontSize="32" 
                           TextTrimming="WordEllipsis"
                           Margin="0,8,0,0"/>

                <TextBlock x:Name="ChatSubtitleTextBlock" 
                           Text="в сети" 
                           FontFamily="Segoe UI" 
                           FontSize="13" 
                           Foreground="{StaticResource PhoneSubtleForegroundBrush}"
                           Margin="0,1,0,0"/>
            </StackPanel>
        </Border>

        <phone:LongListSelector 
            x:Name="MessagesList"
            Grid.Row="1"
            ItemsSource="{Binding Messages}"
            Margin="16,0,16,0">
            <phone:LongListSelector.ItemTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="{Binding BubbleAlignment}" Margin="{Binding BubbleMargin}">
                        <Border Background="{Binding BubbleBackground}" Padding="12,8,12,8" toolkit:TiltEffect.IsTiltEnabled="True">
                            <toolkit:ContextMenuService.ContextMenu>
                                <toolkit:ContextMenu>
                                    <toolkit:MenuItem Header="копировать текст" Click="CopyMessage_Click"/>
                                    <toolkit:MenuItem Header="переслать в чат..." Click="ForwardMessage_Click"/>
                                    <toolkit:MenuItem Header="удалить для меня" Click="DeleteForMe_Click"/>
                                    <toolkit:MenuItem Header="удалить для всех" Click="DeleteForEveryone_Click"/>
                                </toolkit:ContextMenu>
                            </toolkit:ContextMenuService.ContextMenu>

                            <StackPanel MaxWidth="320">
                                <TextBlock Text="{Binding AuthorName}" 
                                           Visibility="{Binding AuthorVisibility}"
                                           FontFamily="Segoe UI Semibold" 
                                           FontSize="13" 
                                           Foreground="{StaticResource PhoneAccentBrush}"
                                           Margin="0,0,0,4"/>

                                <Border Visibility="{Binding PhotoVisibility}" 
                                        CornerRadius="2" 
                                        MaxHeight="260" 
                                        MaxWidth="250" 
                                        Margin="0,0,0,6" 
                                        Background="#0A0A0A">
                                    <Image Source="{Binding PhotoImage}" 
                                           Stretch="Uniform"
                                           Tap="PhotoImage_Tap"/>
                                </Border>

                                <TextBlock Text="{Binding Text}" 
                                           FontFamily="Segoe UI" 
                                           FontSize="18" 
                                           Foreground="White"
                                           TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding FormattedTime}" 
                                               FontFamily="Segoe UI" 
                                               FontSize="11" 
                                               Foreground="#99FFFFFF"
                                               Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding StatusIcon}" 
                                               Visibility="{Binding StatusVisibility}"
                                               FontFamily="Segoe UI" 
                                               FontSize="11" 
                                               Foreground="White"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </phone:LongListSelector.ItemTemplate>
        </phone:LongListSelector>

        <Border Grid.Row="2" Background="#111111" Padding="8,6,8,8" BorderThickness="0,1,0,0" BorderBrush="#222222">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="AttachPhotoButton" 
                        Grid.Column="0" 
                        Click="AttachPhotoButton_Click"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Padding="0"
                        Width="70" Height="70"
                        VerticalAlignment="Bottom">
                    <TextBlock Text="&#xE16C;" 
                               FontFamily="Segoe UI Symbol" 
                               FontSize="22" 
                               Foreground="{StaticResource PhoneAccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>

                <TextBox x:Name="MessageInputBox" 
                         Grid.Column="1"
                         FontFamily="Segoe UI"
                         FontSize="18"
                         TextWrapping="Wrap"
                         MaxHeight="120"
                         Margin="4,0,4,0"
                         VerticalAlignment="Center"
                         KeyDown="MessageInputBox_KeyDown"/>

                <Button x:Name="SendButton" 
                        Grid.Column="2" 
                        Click="SendButton_Click"
                        Background="{StaticResource PhoneAccentBrush}"
                        BorderBrush="{StaticResource PhoneAccentBrush}"
                        Padding="0"
                        Width="70" Height="70"
                        VerticalAlignment="Bottom">
                    <TextBlock Text="&#xE111;" 
                               FontFamily="Segoe UI Symbol" 
                               FontSize="20" 
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>
    </Grid>

</phone:PhoneApplicationPage>