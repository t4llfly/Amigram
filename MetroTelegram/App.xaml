<Application
    x:Class="MetroTelegram.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:converters="clr-namespace:MetroTelegram.Converters">

    <Application.Resources>
        <converters:MessageDateConverter x:Key="MessageDateConverter"/>
        <converters:UnreadCountToVisibilityConverter x:Key="UnreadCountToVisibilityConverter"/>

        <SolidColorBrush x:Key="OledPureBlackBrush" Color="#FF000000"/>
        <SolidColorBrush x:Key="SubtleGrayBrush" Color="#FF181818"/>
        <SolidColorBrush x:Key="IncomingBubbleBrush" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="PhoneSubtleForegroundBrush" Color="#FF8E8E93"/>

        <DataTemplate x:Key="MetroPivotTitleTemplate">
            <TextBlock Text="{Binding}" 
                       FontSize="13" 
                       FontFamily="Segoe UI Semibold" 
                       Margin="0,14,0,0" 
                       Foreground="{StaticResource PhoneSubtleForegroundBrush}"/>
        </DataTemplate>

        <Style x:Key="ChatTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="{StaticResource PhoneForegroundBrush}"/>
            <Setter Property="TextTrimming" Value="WordEllipsis"/>
        </Style>

        <Style x:Key="ChatPreviewTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource PhoneSubtleForegroundBrush}"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MaxHeight" Value="22"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="WordEllipsis"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Application.Resources>

    <Application.ApplicationLifetimeObjects>
        <shell:PhoneApplicationService
            Launching="Application_Launching" 
            Closing="Application_Closing" 
            Activated="Application_Activated" 
            Deactivated="Application_Deactivated"/>
    </Application.ApplicationLifetimeObjects>
</Application>